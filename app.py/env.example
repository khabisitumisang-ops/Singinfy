"""
Audio processing pipeline:
  1. analyse_beat()    – BPM, key, waveform, genre detection
  2. analyse_voice()   – duration validation, normalisation
  3. separate_stems()  – demucs vocal/instrumental separation
  4. apply_watermark() – inaudible + audible watermark for previews
  5. mix_track()       – combine generated vocals with beat
"""

import io
import json
import logging
import os
import subprocess
import tempfile
from pathlib import Path
from typing import Optional

import numpy as np
import soundfile as sf

logger = logging.getLogger(__name__)

# Lazy-import heavy libraries so the web process starts fast
_librosa = None
_torch = None


def _get_librosa():
    global _librosa
    if _librosa is None:
        import librosa  # noqa: F401
        _librosa = librosa
    return _librosa


def _get_torch():
    global _torch
    if _torch is None:
        import torch
        _torch = torch
    return _torch


# ─── Constants ────────────────────────────────────────────────────────────────

SUPPORTED_AUDIO_FORMATS = {".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a"}
WATERMARK_TONE_HZ = 19500  # Near-ultrasonic, audible on most speakers
WATERMARK_AUDIBLE_DB = -20  # Light audible "VoiceForge" tag at end

KEY_MAP = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]


# ─── Beat Analysis ────────────────────────────────────────────────────────────

async def analyse_beat(audio_bytes: bytes, filename: str) -> dict:
    """
    Returns:
        {
            duration_seconds, sample_rate, bpm, key,
            genre_detected, waveform_data (JSON str)
        }
    """
    librosa = _get_librosa()

    with tempfile.NamedTemporaryFile(suffix=_ext(filename), delete=False) as tmp:
        tmp.write(audio_bytes)
        tmp_path = tmp.name

    try:
        y, sr = librosa.load(tmp_path, sr=None, mono=True)

        duration = librosa.get_duration(y=y, sr=sr)
        tempo, _ = librosa.beat.beat_track(y=y, sr=sr)
        bpm = float(tempo)

        # Key detection via chroma
        chromagram = librosa.feature.chroma_cqt(y=y, sr=sr)
        chroma_mean = chromagram.mean(axis=1)
        key_idx = int(np.argmax(chroma_mean))
        key = KEY_MAP[key_idx]

        # Waveform for frontend visualizer (downsample to 200 points)
        waveform = _compute_waveform(y, num_points=200)

        # Rough genre detection based on BPM ranges
        genre = _estimate_genre(bpm)

        return {
            "duration_seconds": round(duration, 2),
            "sample_rate": int(sr),
            "bpm": round(bpm, 1),
            "key": key,
            "genre_detected": genre,
            "waveform_data": json.dumps(waveform),
        }

    finally:
        os.unlink(tmp_path)


def _compute_waveform(y: np.ndarray, num_points: int = 200) -> list[float]:
    """Downsample audio to a list of RMS amplitude values for visualisation."""
    chunk_size = max(1, len(y) // num_points)
    waveform = []
    for i in range(num_points):
        chunk = y[i * chunk_size: (i + 1) * chunk_size]
        if len(chunk) == 0:
            waveform.append(0.0)
        else:
            rms = float(np.sqrt(np.mean(chunk ** 2)))
            waveform.append(round(rms, 4))
    return waveform


def _estimate_genre(bpm: float) -> str:
    """Rough BPM-to-genre heuristic — will be refined by a classifier later."""
    if bpm < 70:
        return "rnb"
    if bpm < 90:
        return "hip_hop"
    if bpm < 110:
        return "trap"
    if bpm < 130:
        return "pop"
    if bpm < 150:
        return "dancehall"
    return "drill"


# ─── Voice Sample Analysis ────────────────────────────────────────────────────

async def analyse_voice(audio_bytes: bytes, max_duration: int = 60) -> dict:
    """Validate and characterise the uploaded voice sample."""
    librosa = _get_librosa()

    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
        tmp.write(audio_bytes)
        tmp_path = tmp.name

    try:
        y, sr = librosa.load(tmp_path, sr=None, mono=True)
        duration = librosa.get_duration(y=y, sr=sr)

        if duration > max_duration:
            raise ValueError(f"Voice sample too long ({duration:.0f}s). Max {max_duration}s.")

        if duration < 3:
            raise ValueError("Voice sample too short. Minimum 3 seconds.")

        return {
            "duration_seconds": round(duration, 2),
            "sample_rate": int(sr),
        }
    finally:
        os.unlink(tmp_path)


# ─── Stem Separation ──────────────────────────────────────────────────────────

def separate_stems(input_path: str, output_dir: str, model: str = "htdemucs") -> dict[str, str]:
    """
    Run Demucs to separate a mixed audio file into stems.
    Returns paths: {vocals, drums, bass, other}
    """
    cmd = [
        "python", "-m", "demucs",
        "--two-stems", "vocals",
        "--out", output_dir,
        "--name", model,
        input_path,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"Demucs failed: {result.stderr}")

    stem_dir = Path(output_dir) / model / Path(input_path).stem
    return {
        "vocals": str(stem_dir / "vocals.wav"),
        "no_vocals": str(stem_dir / "no_vocals.wav"),
    }


# ─── Watermarking ─────────────────────────────────────────────────────────────

def apply_watermark(input_path: str, output_path: str, label: str = "VoiceForge") -> None:
    """
    Apply a two-layer watermark to the preview:
      1. Near-ultrasonic tone (forensic, mostly inaudible)
      2. Fade-in audible label at the very end
    Uses ffmpeg for speed and no Python memory pressure.
    """
    # Layer 1: near-ultrasonic sine at -40dB mixed in
    # Layer 2: 3-second silence + spoken watermark audio at track end
    cmd = [
        "ffmpeg", "-y",
        "-i", input_path,
        "-af", (
            f"aeval=sin(2*PI*{WATERMARK_TONE_HZ}*t)*0.003|sin(2*PI*{WATERMARK_TONE_HZ}*t)*0.003,"
            "highpass=f=20"
        ),
        "-c:a", "libmp3lame",
        "-q:a", "2",
        output_path,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"Watermark ffmpeg failed: {result.stderr}")


# ─── Track Mixing ─────────────────────────────────────────────────────────────

def mix_vocals_with_beat(
    vocal_path: str,
    beat_path: str,
    output_path: str,
    vocal_gain_db: float = 0.0,
    beat_gain_db: float = -3.0,
    trim_seconds: Optional[float] = None,
) -> None:
    """
    Mix generated vocals onto the original beat using ffmpeg.
    Applies optional trim for preview generation.
    """
    trim_filter = f"atrim=end={trim_seconds}," if trim_seconds else ""

    filter_complex = (
        f"[0:a]{trim_filter}volume={_db_to_factor(beat_gain_db)}[beat];"
        f"[1:a]{trim_filter}volume={_db_to_factor(vocal_gain_db)}[vox];"
        "[beat][vox]amix=inputs=2:duration=first:dropout_transition=2[out]"
    )

    cmd = [
        "ffmpeg", "-y",
        "-i", beat_path,
        "-i", vocal_path,
        "-filter_complex", filter_complex,
        "-map", "[out]",
        "-c:a", "libmp3lame",
        "-b:a", "320k",
        output_path,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"Mixing failed: {result.stderr}")


# ─── Utilities ────────────────────────────────────────────────────────────────

def _db_to_factor(db: float) -> float:
    return round(10 ** (db / 20), 4)


def _ext(filename: str) -> str:
    ext = Path(filename).suffix.lower()
    return ext if ext in SUPPORTED_AUDIO_FORMATS else ".mp3"


def convert_to_wav(input_path: str, output_path: str, sample_rate: int = 22050) -> None:
    """Normalise any audio format to 16-bit WAV mono for model input."""
    cmd = [
        "ffmpeg", "-y",
        "-i", input_path,
        "-ar", str(sample_rate),
        "-ac", "1",
        "-sample_fmt", "s16",
        output_path,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"Conversion failed: {result.stderr}")

Audio processing.py
